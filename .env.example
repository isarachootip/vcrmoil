# ─────────────────────────────────────────────
# vCRM — environment variables (copy to .env, NEVER commit .env)
# ─────────────────────────────────────────────

# App
NODE_ENV=development
BASE_DOMAIN=localhost               # tenants resolve as <slug>.localhost in dev
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_LOCALE=th

# Database (app role WITHOUT BYPASSRLS; migration role separate)
DATABASE_URL=postgresql://vcrm_app:changeme@localhost:5432/vcrm
DATABASE_MIGRATION_URL=postgresql://vcrm_owner:changeme@localhost:5432/vcrm

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO in dev, S3 in cloud)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-7
S3_BUCKET=vcrm-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Search
OPENSEARCH_URL=http://localhost:9200

# Auth
AUTH_MODE=oidc                      # oidc | local (tests)
OIDC_ISSUER_URL=http://localhost:8080/realms/vcrm
OIDC_CLIENT_ID=vcrm-web
OIDC_CLIENT_SECRET=
JWT_LOCAL_SECRET=dev-only-change-me

# Email (MailHog in dev, SES in cloud)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@vcrm.local

# ─── AI (cloud providers) — keys stay here or in Secrets Manager, never in prompts/code ───
AI_STT_PROVIDER=mock                # mock | google | azure | openai
AI_LLM_PROVIDER=mock                # mock | anthropic | azure-openai | bedrock
AI_EMBEDDING_PROVIDER=mock
AI_PII_REDACTION=true
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_BEDROCK_REGION=

# ─── Channels (per-tenant values live in DB/Secrets Manager; these are dev defaults) ───
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=

# ─── 3CX V20 (dev/test instance; per-tenant values live in Secrets Manager) ───
PBX_ADAPTER=mock                    # mock | 3cx-v20
TCX_FQDN=                           # e.g. yourcompany.3cx.asia
TCX_CRM_TEMPLATE_API_KEY=
TCX_CALL_CONTROL_CLIENT_ID=         # requires 8SC+ license
TCX_CALL_CONTROL_CLIENT_SECRET=
TCX_XAPI_CLIENT_ID=                 # requires 8SC+ license
TCX_XAPI_CLIENT_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
