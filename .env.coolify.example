# ===================================================
# vCRM — Environment Variables for Coolify Deployment
# ===================================================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Domain & URLs
BASE_DOMAIN=vcrm.yourdomain.com
API_URL=https://api.vcrm.yourdomain.com
WEB_URL=https://app.vcrm.yourdomain.com

# Database (PostgreSQL 16 with RLS)
# In Coolify Docker Compose, host is 'postgres'
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_APP_PASSWORD=generate_a_secure_app_password_here
POSTGRES_OWNER_PASSWORD=generate_a_secure_owner_password_here

DATABASE_URL=postgresql://vcrm_app:generate_a_secure_app_password_here@postgres:5432/vcrm
DATABASE_MIGRATION_URL=postgresql://vcrm_owner:generate_a_secure_owner_password_here@postgres:5432/vcrm

# Redis
REDIS_URL=redis://redis:6379

# Authentication
# AUTH_MODE: 'local' (email+password JWT) or 'oidc' (Keycloak)
AUTH_MODE=local
JWT_LOCAL_SECRET=generate_a_random_64_char_secret_for_production_jwt

# Keycloak OIDC (if AUTH_MODE=oidc)
OIDC_ISSUER_URL=https://auth.yourdomain.com/realms/vcrm
OIDC_CLIENT_ID=vcrm-web
OIDC_CLIENT_SECRET=
