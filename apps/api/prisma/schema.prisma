datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Tenant {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String         @unique @db.VarChar(63)
  name       String         @db.VarChar(255)
  status     String         @default("trial") @db.VarChar(32) // trial | active | suspended
  plan       String         @default("standard") @db.VarChar(64)
  settings   Json           @default("{\"timezone\": \"Asia/Bangkok\", \"locale\": \"th\"}")
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  configs    TenantConfig[]
  users      User[]
  teams      Team[]
  roles      Role[]
  skills     Skill[]
  identities UserIdentity[]
  sessions   Session[]

  @@map("tenants")
}

model TenantConfig {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  key        String   @db.VarChar(128)
  value      Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  created_by String?  @db.VarChar(64)
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
  @@index([tenant_id])
  @@map("tenant_configs")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String   @db.VarChar(128)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  created_by  String?  @db.VarChar(64)
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("teams")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String?          @db.Uuid
  name        String           @db.VarChar(64)
  description String?          @db.Text
  is_system   Boolean          @default(false)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @updatedAt @db.Timestamptz(6)
  tenant      Tenant?          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenant_id, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(64) // e.g. 'user.create', 'case.read'
  module      String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.Text
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  data_scope    String     @default("all") @db.VarChar(32) // own | team | all
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String      @db.Uuid
  email                String      @db.VarChar(255)
  name                 String      @db.VarChar(255)
  role_id              String      @db.Uuid
  team_id              String?     @db.Uuid
  status               String      @default("offline") @db.VarChar(32) // online | away | offline
  max_concurrent_chats Int         @default(3)
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime    @updatedAt @db.Timestamptz(6)
  created_by           String?     @db.VarChar(64)
  tenant               Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role                 Role        @relation(fields: [role_id], references: [id])
  team                 Team?          @relation(fields: [team_id], references: [id], onDelete: SetNull)
  skills               UserSkill[]
  identities           UserIdentity[]
  sessions             Session[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@map("users")
}

model Skill {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String      @db.Uuid
  name        String      @db.VarChar(128)
  description String?     @db.Text
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @updatedAt @db.Timestamptz(6)
  tenant      Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_skills UserSkill[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("skills")
}

model UserSkill {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String @db.Uuid
  skill_id String @db.Uuid
  level    Int    @default(1) // 1 to 5
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill_id])
  @@map("user_skills")
}

model UserIdentity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  user_id          String    @db.Uuid
  provider         String    @db.VarChar(32) // local | keycloak
  provider_user_id String    @db.VarChar(255) // email for local, sub for keycloak
  password_hash    String?   @db.VarChar(255)
  last_login_at    DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, provider, provider_user_id])
  @@index([tenant_id])
  @@index([user_id])
  @@map("user_identities")
}

model Session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String    @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(255)
  user_agent         String?   @db.VarChar(512)
  ip_address         String?   @db.VarChar(45)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
  @@map("sessions")
}
